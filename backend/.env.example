# Скопируй в backend/.env и заполни

# dev | prod
ENV=dev

# Локально по умолчанию SQLite (без установки Postgres).
# Для Supabase: Project Settings -> Database -> Connection string (URI), замени postgres:// на postgresql+psycopg://
DATABASE_URL=sqlite:///./dev.db

# Домен фронта (локальный Vite + прод Vercel через запятую)
CORS_ORIGINS=http://localhost:5173

# Supabase: Project Settings -> API -> JWT Secret. Пока пусто — в dev работает заголовок X-Debug-User
SUPABASE_JWT_SECRET=

# Ключ для POST /api/v1/admin/import
ADMIN_API_KEY=dev-admin-key

# CSV-export URL вкладок Google Sheet курации, через запятую
SHEET_CSV_URLS=

# College Scorecard (https://api.data.gov/signup/), для import_scorecard.py; DEMO_KEY работает для проб
SCORECARD_API_KEY=
